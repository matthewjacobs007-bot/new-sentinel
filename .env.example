# Copy to .env and fill in real values. Never commit .env.

PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-random-string
DATABASE_URL=postgresql://localhost/sentinel_dev

# MSP team login (username + password, shared by the whole MSP team)
TEAM_USER=rcs
TEAM_PASS=change-me

# Google Workspace OAuth — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 (Entra ID) OAuth — entra.microsoft.com → App registrations
# MICROSOFT_TENANT_ID defaults to "organizations" (any work/school account can sign in).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations

# Optional: Slack/Teams-compatible webhook URL for posture-regression alerts.
ALERT_WEBHOOK_URL=

# Paystack — powers the client payment wall (/activate). Without this set, the
# payment wall falls back to a "contact us to activate manually" message, and
# MSPs can still activate a tenant manually from that same page.
# Pricing (lib/pricing.js) is always computed and displayed in USD cents. If
# your Paystack account doesn't settle in USD (most don't — e.g. South African
# accounts settle in ZAR), set PAYSTACK_CURRENCY to your account's real
# currency and lib/fx.js converts the USD price to that currency at the
# current exchange rate right before charging. Leave as USD only if your
# account genuinely supports USD settlement.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=ZAR
